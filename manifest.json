{
  "vendor": "odp",
  "name": "return-app",
  "version": "3.20.0",
  "title": "Return app",
  "description": "Return app",
  "dependencies": {
    "vtex.styleguide": "9.x",
    "vtex.format-currency": "0.x",
    "vtex.my-account": "1.x",
    "vtex.my-account-commons": "1.x",
    "vtex.render-runtime": "8.x",
    "vtex.css-handles": "0.x",
    "vtex.easypost": "0.x",
    "vtex.tenant-graphql": "0.x",
    "vtex.catalog-graphql": "1.x"
  },
  "builders": {
    "admin": "0.x",
    "react": "3.x",
    "messages": "1.x",
    "docs": "0.x",
    "store": "0.x",
    "node": "6.x",
    "graphql": "2.x",
    "masterdata": "1.x"
  },
  "scripts": {
    "postreleasy": "vtex publish --verbose"
  },
  "settingsSchema": {
    "title": "Application Configuration",
    "type": "object",
    "properties": {
      "dynatraceToken": {
        "title": "Dynatrace API Token",
        "description": "Dynatrace API token for logging (plain text). Contact admin if not available.",
        "type": "string"
      },
      "loggingEnvironment": {
        "title": "Logging Environment",
        "description": "Environment for Dynatrace logging (dev or prod)",
        "type": "string",
        "enum": ["dev", "prod"],
        "default": "dev"
      },
      "enableDynatraceLogging": {
        "title": "Enable Dynatrace Logging",
        "description": "Enable/disable sending logs to Dynatrace",
        "type": "boolean",
        "default": true
      },
      "logLevel": {
        "title": "Log Level",
        "description": "Minimum log level to send to Dynatrace",
        "type": "string",
        "enum": ["debug", "info", "warn", "error"],
        "default": "info"
      }
    }
  },
  "credentialType": "absolute",
  "policies": [
    {
      "name": "outbound-access",
      "attrs": {
        "host": "{{account}}.vtexcommercestable.com.br",
        "path": "*"
      }
    },
    {
      "name": "outbound-access",
      "attrs": {
        "host": "infra.io.vtex.com",
        "path": "*"
      }
    },
    {
      "name": "outbound-access",
      "attrs": {
        "host": "portal.vtexcommercestable.com.br",
        "path": "/api/oms/pvt/orders/*"
      }
    },
    {
      "name": "colossus-fire-event"
    },
    {
      "name": "colossus-write-logs"
    },
    {
      "name": "vbase-read-write"
    },
    {
      "name": "ADMIN_DS"
    },
    {
      "name": "POWER_USER_DS"
    },
    {
      "name": "OMSViewer"
    },
    {
      "name": "ListOrders"
    },
    {
      "name": "outbound-access",
      "attrs": {
        "host": "api.vtex.com",
        "path": "/dataentities/*"
      }
    },
    {
      "name": "sphinx-is-admin"
    },
    {
      "name": "vtex.catalog-graphql:resolve-graphql"
    },
    {
      "name": "outbound-access",
      "attrs": {
        "host": "ooq19131.live.dynatrace.com",
        "path": "*"
      }
    },
    {
      "name": "outbound-access",
      "attrs": {
        "host": "wdl06559.live.dynatrace.com",
        "path": "*"
      }
    },
    {
      "name": "outbound-access",
      "attrs": {
        "host": "*.dynatrace.com",
        "path": "*"
      }
    }
  ],
  "billingOptions": {
    "termsURL": "https://compliance.vtex.com/gdpr/policies/vtex-privacy-policy",
    "support": {
      "url": "https://support.vtex.com/hc/requests"
    },
    "free": true
  },
  "$schema": "https://raw.githubusercontent.com/vtex/node-vtex-api/master/gen/manifest.schema"
}
