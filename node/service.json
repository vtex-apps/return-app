{
  "memory": 512,
  "ttl": 60,
  "timeout": 5000,
  "minReplicas": 2,
  "maxReplicas": 4,
  "routes": {
    "returnRequests": {
      "path": "/_v/return-request",
      "public": true
    },
    "returnRequest": {
      "path": "/_v/return-request/:requestId",
      "public": true
    },
    "returnRequestAdditionalInfo": {
      "path": "/_v/return-request/:requestId/additional-info",
      "public": true
    },
    "adjustmentNotes": {
      "path": "/_v/adjustment-note",
      "public": true
    },
    "adjustmentNote": {
      "path": "/_v/adjustment-note/:adjustmentId",
      "public": true
    },
    "adjustmentNoteAdditionalInfo": {
      "path": "/_v/adjustment-note/:adjustmentId/additional-info",
      "public": true
    },
    "orderDataStats": {
      "path": "/_v/order-data/:orderId/stats",
      "public": true
    },
    "keepAlive": {
      "path": "/_v/private/return-app/_v/keep-alive",
      "public": true
    }
  }
}
